{
  "scopeName": "source.plainsong",
  "name": "Plainsong",
  "patterns": [
    { "include": "#track-header" },
    { "include": "#metadata-block" },
    { "include": "#metadata-directives" },
    { "include": "#section-header" },
    { "include": "#keychange-block" },
    { "include": "#comments" },
    { "include": "#track-labels" },
    { "include": "#player-line" },
    { "include": "#dynamics-line" },
    { "include": "#articulation-line" },
    { "include": "#rest-line" },
    { "include": "#pipe-content" }
  ],
  "repository": {
    "track-header": {
      "match": "^\\*\\*(TRACK:\\s*.+?)\\*\\*\\s*$",
      "name": "entity.name.track.plainsong",
      "captures": {
        "1": {
          "name": "entity.name.track.plainsong"
        }
      }
    },

    "metadata-block": {
      "match": "^\\[MetaData\\]\\s*$",
      "name": "keyword.control.metadata-block.plainsong"
    },

    "metadata-directives": {
      "patterns": [
        {
          "match": "(?i)^(key|tempo|swing|subdivision|meter|time)\\s*[:)]",
          "name": "keyword.control.directive.plainsong"
        },
        {
          "match": "\\b(\\d+)\\s*(bpm|BPM)\\b",
          "name": "constant.numeric.tempo.plainsong"
        },
        {
          "match": "\\b\\d+\\s*/\\s*\\d+\\b",
          "name": "constant.numeric.time-signature.plainsong"
        },
        {
          "match": "(?i)\\bswing\\s*:?\\s*(\\d+%)?\\b",
          "name": "keyword.control.swing.plainsong",
          "captures": {
            "1": { "name": "constant.numeric.swing-value.plainsong" }
          }
        },
        {
          "match": "(?i)\\bsubdivision\\s*:?\\s*(8th|16th|32nd)\\b",
          "name": "keyword.control.subdivision.plainsong",
          "captures": {
            "1": { "name": "constant.language.subdivision-value.plainsong" }
          }
        }
      ]
    },

    "section-header": {
      "match": "^\\[([A-Za-z0-9]+)\\]\\s*(?:\\([^)]*\\))?",
      "name": "markup.heading.section.plainsong",
      "captures": {
        "1": { "name": "entity.name.section.plainsong" },
        "2": { "name": "comment.section-description.plainsong" }
      }
    },

    "keychange-block": {
      "match": "^\\[KeyChange\\]\\s*$",
      "name": "keyword.control.keychange.plainsong"
    },

    "comments": {
      "patterns": [
        {
          "match": "^\\s*(//|/).*$",
          "name": "comment.line.double-slash.plainsong"
        },
        {
          "match": "^\\s*#.*$",
          "name": "comment.line.hash.plainsong"
        }
      ]
    },

    "track-labels": {
      "patterns": [
        {
          "match": "^(Chords):\\s*",
          "name": "keyword.control.track-label.plainsong",
          "captures": {
            "1": { "name": "support.type.chords-label.plainsong" }
          }
        },
        {
          "match": "^(Melody):\\s*",
          "name": "keyword.control.track-label.plainsong",
          "captures": {
            "1": { "name": "support.type.melody-label.plainsong" }
          }
        },
        {
          "match": "^(Lyrics):\\s*",
          "name": "keyword.control.track-label.plainsong",
          "captures": {
            "1": { "name": "support.type.lyrics-label.plainsong" }
          }
        },
        {
          "match": "^(Dyn(?:amics)?)\\s*:",
          "name": "keyword.control.track-label.plainsong",
          "captures": {
            "1": { "name": "support.type.dynamics-label.plainsong" }
          }
        },
        {
          "match": "^(Art)\\s*:",
          "name": "keyword.control.track-label.plainsong",
          "captures": {
            "1": { "name": "support.type.articulation-label.plainsong" }
          }
        },
        {
          "match": "^(Rest)\\s*:",
          "name": "keyword.control.track-label.plainsong",
          "captures": {
            "1": { "name": "support.type.rest-label.plainsong" }
          }
        }
      ]
    },

    "player-line": {
      "match": "^(@)(\\w+)",
      "name": "entity.name.player.plainsong",
      "captures": {
        "1": { "name": "punctuation.definition.player.plainsong" },
        "2": { "name": "variable.other.readwrite.instance.player-name.plainsong" }
      }
    },

    "dynamics-line": {
      "match": "\\b(pp|p|mp|mf|f|ff|fp|sfz|sf|sfp)\\b",
      "name": "constant.language.dynamic.plainsong"
    },

    "articulation-line": {
      "match": "(?<=\\|)\\s*([.()>\\-])",
      "name": "keyword.operator.articulation.plainsong"
    },

    "rest-line": {
      "patterns": [
        {
          "match": "\\bR\\d+\\b",
          "name": "constant.language.multibar-rest.plainsong"
        }
      ]
    },

    "pipe-content": {
      "patterns": [
        {
          "match": "\\|{1,2}(:?)",
          "name": "punctuation.separator.pipe.plainsong",
          "captures": {
            "1": { "name": "punctuation.separator.repeat.plainsong" }
          }
        },
        {
          "match": ":?\\|{1,2}",
          "name": "punctuation.separator.pipe.plainsong"
        },
        {
          "comment": "Scientific pitch notation: letter name + optional accidental + octave number (e.g. C4, Bb2, F#5)",
          "match": "\\b([A-Ga-g])([#b]{0,2})(\\d)\\b",
          "name": "constant.numeric.note.plainsong",
          "captures": {
            "1": { "name": "entity.name.note-name.plainsong" },
            "2": { "name": "entity.name.accidental.plainsong" },
            "3": { "name": "entity.name.octave.plainsong" }
          }
        },
        {
          "comment": "Chord symbols: letter name + quality (e.g. Am, Fmaj7, Cdim, Gsus4)",
          "match": "\\b([A-G])([#b]?)(maj\\d?|min\\d?|m\\d?|dim\\d?|aug\\d?|sus[24]?|add\\d+|dom7|maj7|min7|\\d+m?\\+?)\\b",
          "name": "entity.name.chord-symbol.plainsong",
          "captures": {
            "1": { "name": "entity.name.chord-root.plainsong" },
            "2": { "name": "entity.name.accidental.plainsong" },
            "3": { "name": "entity.name.chord-quality.plainsong" }
          }
        },
        {
          "comment": "Simple chord root without explicit quality (e.g. C, Am, F)",
          "match": "\\b([A-G])([#b]?)(m?)\\b(?=\\s|\\||$)",
          "name": "entity.name.chord-root-simple.plainsong"
        },
        {
          "comment": "Roman numeral chord notation (v1 format): i, IV, vii°, V7, bIII, etc.",
          "match": "\\b([bB]?)(I{1,3}|IV|VI{0,3}|i{1,3}|iv|vi{0,3})(°|o|\\+|7|maj7|min7|dim|aug)?\\b",
          "name": "entity.name.roman-numeral.plainsong"
        },
        {
          "comment": "Scale degree numbers (v1 melody notation): 1, 2, 5, b3, #4, etc.",
          "match": "(?<![A-Ga-g])([#b]?)(\\d)(\\^|_)?",
          "name": "constant.numeric.scale-degree.plainsong",
          "captures": {
            "1": { "name": "entity.name.accidental.plainsong" },
            "2": { "name": "constant.numeric.scale-degree-value.plainsong" },
            "3": { "name": "keyword.operator.octave-shift.plainsong" }
          }
        },
        {
          "comment": "Sustain / rest dot",
          "match": "(?<=\\s)\\.(?=\\s|\\||$)",
          "name": "constant.language.sustain.plainsong"
        },
        {
          "comment": "Continuation / tie hyphen",
          "match": "(?<=\\s)-(?=\\s|\\||$)",
          "name": "constant.language.tie.plainsong"
        },
        {
          "comment": "Repeat markers: ||: and :||",
          "match": "\\|\\|:|:\\|\\|",
          "name": "keyword.operator.repeat-marker.plainsong"
        },
        {
          "comment": "Ending markers: [1. [2.",
          "match": "\\[\\d+\\.",
          "name": "keyword.operator.ending-marker.plainsong"
        },
        {
          "comment": "Velocity marker: vel: N",
          "match": "(?i)\\bvel\\s*:\\s*\\d+\\b",
          "name": "constant.numeric.velocity.plainsong"
        },
        {
          "comment": "Hyphenated chord/multi-note token: c2-e2-g2, e2-.-g2, c3--e3",
          "match": "(?<=[\\s|])([A-Ga-g][#b]?\\d)(-(?:[A-Ga-g][#b]?\\d|\\.)+)",
          "name": "entity.name.chord-cluster.plainsong"
        },
        {
          "comment": "D.S. al Coda and Coda markers",
          "match": "(?i)\\b(D\\.S\\.|al\\s*Coda|Coda|Fine|D\\.C\\.)\\b",
          "name": "keyword.control.navigation.plainsong"
        }
      ]
    }
  }
}
