{
  "name": "plainsong",
  "displayName": "Plainsong",
  "description": "Syntax highlighting, snippets, and linting for Plainsong music notation files.",
  "version": "0.1.0",
  "publisher": "SuperInstance",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SuperInstance/plainsong"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "music",
    "notation",
    "plainsong",
    "midi",
    "composition"
  ],
  "activationEvents": [
    "onLanguage:plainsong"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "plainsong",
        "aliases": [
          "Plainsong",
          "plainsong"
        ],
        "extensions": [
          ".song"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "plainsong",
        "scopeName": "source.plainsong",
        "path": "./syntaxes/plainsong.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "plainsong",
        "path": "./snippets/plainsong.json"
      }
    ],
    "commands": [
      {
        "command": "plainsong.checkPipeBalance",
        "title": "Plainsong: Check Pipe Delimiter Balance"
      }
    ]
  },
  "scripts": {
    "test": "node ./test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@types/node": "^18.0.0"
  }
}
